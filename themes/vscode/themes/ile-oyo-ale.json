  "tokenColors": [
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#F4E6CE"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F4E6CE"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8994AA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage",
        "storage.type",
        "storage.modifier",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#E86A8F"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#8F9964"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#DAA520"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#BA83A5"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#6B9D9D"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#CE8154",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#8F9964"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml.doctype"
      ],
      "settings": {
        "foreground": "#E86A8F"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#EC6C64"
      }
    },
    {
      "name": "Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6B9D9D"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#EC6C64"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#8F9964"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#CE8154"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#BA83A5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DAA520",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#CE8154",
        "fontStyle": "bold"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#BA83A5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Escape sequences",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E86A8F"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.inline"
      ],
      "settings": {
        "foreground": "#8F9964"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8994AA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EC6C64",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#CE8154",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "meta.template.expression",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#F4E6CE"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#CE8154",
      "italic": true
    },
    "property": "#8F9964",
    "property.declaration": "#8F9964",
    "function": "#8F9964",
    "method": "#8F9964",
    "class": "#6B9D9D",
    "interface": "#6B9D9D",
    "type": "#6B9D9D",
    "typeParameter": "#6B9D9D",
    "namespace": "#6B9D9D",
    "enum": "#6B9D9D",
    "enumMember": "#BA83A5",
    "variable": "#F4E6CE",
    "variable.defaultLibrary": "#6B9D9D",
    "variable.readonly.defaultLibrary": "#BA83A5",
    "keyword": "#E86A8F",
    "decorator": "#8F9964",
    "regexp": "#EC6C64"
  }
}
